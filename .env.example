# Magaya API connection (SOAP XML Web Service over HTTPS).
# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.
#
# Each user/integration configures their own credentials here. Best practice
# (per the Magaya API docs): one dedicated API user per integration.

# Communication Server endpoint. For Magaya cloud installs the shape is:
#   https://<COMPANY_ID>.magayacloud.com/api/Invoke?Handler=CSSoapService
MAGAYA_API_URL=

# API username (case sensitive) and password for the employee account with API access.
MAGAYA_USERNAME=
MAGAYA_PASSWORD=
